{
  "name": "@sewadah/selaras",
  "type": "module",
  "version": "0.2.0",
  "description": "A UI component library for Nuxt, built on Reka UI and Tailwind v4",
  "author": "Wicaksana Pratama <wicaksanapratama@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/sewadahapp/selaras#readme",
  "repository": "sewadahapp/selaras",
  "bugs": "https://github.com/sewadahapp/selaras/issues",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "vue",
    "vue-components",
    "component-library",
    "ui-library",
    "ui-kit",
    "design-system",
    "tailwindcss",
    "reka-ui",
    "headless-ui",
    "oklch"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "style": "./dist/runtime/theme.css",
      "import": "./dist/module.mjs"
    },
    "./directives": {
      "types": "./dist/runtime/directives/index.d.ts",
      "import": "./dist/runtime/directives/index.js"
    },
    "./types": {
      "types": "./dist/runtime/types/index.d.ts",
      "import": "./dist/runtime/types/index.js"
    },
    "./table": {
      "types": "./dist/runtime/table.d.ts",
      "import": "./dist/runtime/table.js"
    },
    "./theme": {
      "types": "./dist/runtime/theme-api.d.ts",
      "import": "./dist/runtime/theme-api.js"
    },
    "./components/DrawerRenderer*": {},
    "./components/ModalRenderer*": {},
    "./components/NavigationMenuAccordionItem*": {},
    "./components/NavigationMenuFlyoutList*": {},
    "./components/NavigationMenuFlyoutTrigger*": {},
    "./components/SlideoverRenderer*": {},
    "./components/*": "./dist/runtime/components/*",
    "./theme.css": "./dist/runtime/theme.css",
    "./structural.css": "./dist/runtime/structural.css",
    "./prose.css": "./dist/runtime/prose.css",
    "./tokens/default-colors.tokens.json": "./dist/tokens/default-colors.tokens.json"
  },
  "main": "./dist/module.mjs",
  "style": "./dist/runtime/theme.css",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "directives": [
        "./dist/runtime/directives/index.d.ts"
      ],
      "types": [
        "./dist/runtime/types/index.d.ts"
      ],
      "table": [
        "./dist/runtime/table.d.ts"
      ],
      "theme": [
        "./dist/runtime/theme-api.d.ts"
      ],
      "components/DrawerRenderer*": [],
      "components/ModalRenderer*": [],
      "components/NavigationMenuAccordionItem*": [],
      "components/NavigationMenuFlyoutList*": [],
      "components/NavigationMenuFlyoutTrigger*": [],
      "components/SlideoverRenderer*": [],
      "components/*": [
        "./dist/runtime/components/*"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "workspaces": [
    "docs",
    "packages/docs"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "bun run docs:dev",
    "dev:build": "bun run docs:build",
    "dev:generate": "bun run docs:generate",
    "dev:preview": "bunx nuxt preview docs",
    "dev:prepare": "bun run docs:prepare",
    "docs:build": "nuxt build docs",
    "docs:dev": "bun run docs:prepare && nuxt dev docs",
    "docs:generate": "nuxt generate docs",
    "docs:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare docs && bun run scripts/sync-workspace-dist.mjs",
    "docs:types": "cd docs && vue-tsc --noEmit",
    "docs-template:dev": "bun run docs-template:prepare && nuxt dev packages/docs/preview",
    "docs-template:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare packages/docs/preview",
    "release": "bun run release:both",
    "release:both": "bun run release:selaras && bun run release:docs",
    "release:selaras": "bun run lint && bun run test && changelogen --bump && bun run test:release && npm publish --access public && bash scripts/tag-and-push-release.sh selaras && changelogen gh release",
    "release:docs": "node scripts/bump-docs-layer.mjs && node scripts/prepare-docs-layer-release.mjs --verify && bun run test:release && node scripts/prepare-docs-layer-release.mjs && (cd packages/docs && npm publish --access public) && node scripts/prepare-docs-layer-release.mjs --restore && bash scripts/tag-and-push-release.sh selaras-docs",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium",
    "test:compat": "node scripts/test-compatibility.mjs",
    "test:release": "bun run test:types && SELARAS_PACKED_BROWSER=1 bun run test:compat",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && bun run docs:types",
    "tokens:check": "node scripts/generate-default-colors.mjs --check",
    "tokens:generate": "node scripts/generate-default-colors.mjs"
  },
  "peerDependencies": {
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.5.0",
    "@nuxt/icon": "^1.10.3",
    "@nuxt/kit": "^4.5.2",
    "@nuxtjs/color-mode": "^4.0.1",
    "@tailwindcss/oxide": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/vue-table": "^9.1.2",
    "@tanstack/vue-virtual": "^3.13.36",
    "reka-ui": "^2.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@nuxt/devtools": "^3.4.1",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "latest",
    "@vue/test-utils": "^2.4.11",
    "changelogen": "^0.6.2",
    "eslint": "^10.8.1",
    "happy-dom": "^20.11.6",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vee-validate": "4",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
