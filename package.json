{
  "name": "selaras",
  "type": "module",
  "version": "0.1.0",
  "description": "A UI component library for Nuxt",
  "license": "MIT",
  "repository": "wypratama/selaras",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./directives": {
      "types": "./dist/runtime/directives/index.d.ts",
      "import": "./dist/runtime/directives/index.js"
    },
    "./components/*": "./dist/runtime/components/*"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "directives": [
        "./dist/runtime/directives/index.d.ts"
      ],
      "components/*": [
        "./dist/runtime/components/*"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:generate": "nuxt generate playground",
    "dev:preview": "NODE_ENV=production bun playground/.output/server/index.mjs",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@internationalized/date": "^3.5.0",
    "@nuxt/icon": "^1.10.3",
    "@nuxt/kit": "^4.5.2",
    "@nuxtjs/color-mode": "^4.0.1",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/vue-table": "^9.1.2",
    "@tanstack/vue-virtual": "^3.13.36",
    "reka-ui": "^2.2.0",
    "tailwind-variants": "^0.3.1",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@nuxt/devtools": "^3.4.1",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.1.0",
    "@types/node": "latest",
    "@vue/test-utils": "^2.4.11",
    "changelogen": "^0.6.2",
    "eslint": "^10.8.1",
    "happy-dom": "^20.11.6",
    "nuxt": "^4.5.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
