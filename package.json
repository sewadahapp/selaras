{
  "name": "@sewadah/selaras",
  "type": "module",
  "version": "1.1.0",
  "description": "A UI component library for Nuxt, built on Reka UI and Tailwind v4",
  "author": "Wicaksana Pratama <wicaksanapratama@gmail.com>",
  "license": "MIT",
  "homepage": "https://selarasui.my.id",
  "repository": "sewadahapp/selaras",
  "bugs": "https://github.com/sewadahapp/selaras/issues",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "vue",
    "vue-components",
    "component-library",
    "ui-library",
    "ui-kit",
    "design-system",
    "tailwindcss",
    "reka-ui",
    "headless-ui",
    "oklch"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "style": "./dist/runtime/theme.css",
      "import": "./dist/module.mjs"
    },
    "./directives": {
      "types": "./dist/runtime/directives/index.d.ts",
      "import": "./dist/runtime/directives/index.js"
    },
    "./types": {
      "types": "./dist/runtime/types/index.d.ts",
      "import": "./dist/runtime/types/index.js"
    },
    "./table": {
      "types": "./dist/runtime/table.d.ts",
      "import": "./dist/runtime/table.js"
    },
    "./theme": {
      "types": "./dist/runtime/theme-api.d.ts",
      "import": "./dist/runtime/theme-api.js"
    },
    "./components/DrawerRenderer*": {},
    "./components/ConfirmRenderer*": {},
    "./components/ModalRenderer*": {},
    "./components/NavigationMenuAccordionItem*": {},
    "./components/NavigationMenuFlyoutList*": {},
    "./components/NavigationMenuFlyoutTrigger*": {},
    "./components/SlideoverRenderer*": {},
    "./components/*": "./dist/runtime/components/*",
    "./theme.css": "./dist/runtime/theme.css",
    "./structural.css": "./dist/runtime/structural.css",
    "./prose.css": "./dist/runtime/prose.css",
    "./tokens/default-colors.tokens.json": "./dist/tokens/default-colors.tokens.json",
    "./agent/catalog.json": "./dist/agent/catalog.json"
  },
  "main": "./dist/module.mjs",
  "style": "./dist/runtime/theme.css",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "directives": [
        "./dist/runtime/directives/index.d.ts"
      ],
      "types": [
        "./dist/runtime/types/index.d.ts"
      ],
      "table": [
        "./dist/runtime/table.d.ts"
      ],
      "theme": [
        "./dist/runtime/theme-api.d.ts"
      ],
      "components/DrawerRenderer*": [],
      "components/ConfirmRenderer*": [],
      "components/ModalRenderer*": [],
      "components/NavigationMenuAccordionItem*": [],
      "components/NavigationMenuFlyoutList*": [],
      "components/NavigationMenuFlyoutTrigger*": [],
      "components/SlideoverRenderer*": [],
      "components/*": [
        "./dist/runtime/components/*"
      ]
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "workspaces": [
    "docs",
    "packages/docs",
    "packages/mcp"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "bun run docs:prepare && bun run --cwd docs dev",
    "dev:build": "bun run docs:build",
    "dev:generate": "bun run docs:generate",
    "dev:preview": "bunx nuxt preview docs",
    "dev:prepare": "bun run docs:prepare",
    "docs:build": "bun run --cwd docs build",
    "docs:dev": "nuxt-module-build build --stub && bun run scripts/sync-workspace-dist.mjs && nuxt-module-build prepare && nuxt prepare packages/docs/preview && nuxt dev packages/docs/preview",
    "docs:generate": "bun run --cwd docs generate",
    "docs:prepare": "nuxt-module-build build --stub && bun run scripts/sync-workspace-dist.mjs && nuxt-module-build prepare && nuxt prepare docs",
    "docs:types": "cd docs && vue-tsc --noEmit",
    "test:docs-seo": "node scripts/check-docs-seo.mjs",
    "release": "bun run release:selaras-and-docs",
    "release:selaras-and-docs": "bun run release:selaras && bun run release:docs",
    "release:both": "bun run release:selaras-and-docs",
    "release:all": "bun run release:selaras-and-docs && bun run release:mcp",
    "release:selaras": "bun run lint && bun run test && (if [ -n \"$RELEASE_VERSION\" ]; then npx changelogen --bump -r \"$RELEASE_VERSION\"; elif [ \"${RELEASE_BUMP:-auto}\" = \"auto\" ]; then npx changelogen --bump; else npx changelogen --bump \"--$RELEASE_BUMP\"; fi) && bun run test:release && npm publish --access public && bash scripts/tag-and-push-release.sh selaras && changelogen gh release",
    "release:docs": "node scripts/bump-workspace-package.mjs --package docs && node scripts/prepare-docs-layer-release.mjs --verify && bun run test:release && node scripts/prepare-docs-layer-release.mjs && (cd packages/docs && npm publish --access public) && node scripts/prepare-docs-layer-release.mjs --restore && bash scripts/tag-and-push-release.sh selaras-docs",
    "release:mcp": "node scripts/bump-workspace-package.mjs --package mcp && bun run prepack && bun run test:agent && (cd packages/mcp && npm publish --access public) && bash scripts/tag-and-push-release.sh selaras-mcp",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:a11y": "playwright test test/browser/accessibility.spec.ts",
    "test:browser:install": "playwright install chromium",
    "test:compat": "node scripts/test-compatibility.mjs",
    "test:nuxt-compat": "node scripts/test-nuxt-compatibility.mjs",
    "test:release": "bun run test:types && SELARAS_PACKED_BROWSER=1 bun run test:compat",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && bun run docs:types",
    "tokens:check": "node scripts/generate-default-colors.mjs --check",
    "tokens:generate": "node scripts/generate-default-colors.mjs",
    "agent:build": "node scripts/build-agent-catalog.mjs",
    "test:agent": "node scripts/test-agent-support.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "commitlint": "commitlint",
    "check": "bun run lint && bun run docs:prepare && bun run test:types && bun run test",
    "test:docs-markdown": "node scripts/check-docs-markdown.mjs"
  },
  "peerDependencies": {
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/kit": "^4.5.2",
    "@nuxtjs/color-mode": "^4.0.1",
    "@tailwindcss/oxide": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/vue-table": "^9.3.1",
    "@tanstack/vue-virtual": "^3.13.47",
    "reka-ui": "^2.11.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nuxt/devtools": "^3.4.3",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "latest",
    "@vue/test-utils": "^2.5.1",
    "changelogen": "^0.6.2",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.3",
    "husky": "^9.1.7",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vee-validate": "4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "yaml": "^2.9.1"
  }
}
